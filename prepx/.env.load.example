# Copy to ignored .env.load; replace placeholders only with dedicated fictional fixture settings.
BASE_URL=
LOAD_TEST_TARGET_ENV=
LOAD_TEST_EXAMINATION_ID=
LOAD_TEST_INDEX_NUMBER=
LOAD_TEST_NIC=
LOAD_TEST_FIXTURE_CONFIRMED=
LOAD_TEST_SEARCH_PATH=/api/results/search
LOAD_TEST_HEALTH_PATH=/api/health
# Optional Authorization value for an approved protected staging gateway; public APIs need none.
LOAD_TEST_AUTH_HEADER=
K6_PROFILE=smoke
# Required for remote targets; hostname only, without scheme/port.
LOAD_TEST_APPROVED=
LOAD_TEST_APPROVED_HOST=
# Stress/500+ VU approval; use only an approved performance environment.
LOAD_TEST_ALLOW_HIGH_LOAD=
# Separate explicit production approvals; never enable without authorization.
LOAD_TEST_ALLOW_PRODUCTION=
LOAD_TEST_ALLOW_PRODUCTION_STRESS=
# Blank optional values use bounded defaults. Durations below are seconds.
LOAD_TEST_VUS=
LOAD_TEST_DURATION_SECONDS=
LOAD_TEST_RAMP_SECONDS=
LOAD_TEST_PAUSE_SECONDS=
LOAD_TEST_TIMEOUT_SECONDS=
LOAD_TEST_P95_MS=
LOAD_TEST_P99_MS=
LOAD_TEST_ERROR_RATE=
LOAD_TEST_CHECK_FAILURE_RATE=
LOAD_TEST_ABORT_ERROR_RATE=
LOAD_TEST_ABORT_AFTER_SECONDS=
LOAD_TEST_HEALTH_SCENARIO=
LOAD_TEST_EXPORT=
