# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key

# App
NEXT_PUBLIC_APP_NAME=PrepX
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AI import assistant (server-only; never prefix the key with NEXT_PUBLIC_)
# GEMINI_API_KEY=your_actual_gemini_api_key
# GEMINI_IMPORT_MODEL=gemini-3.8-flash

# Public result search rate limits (server-only; see RATE-LIMITING.md)
RESULT_SEARCH_RATE_LIMIT=20
RESULT_SEARCH_RATE_WINDOW_SECONDS=300
RESULT_SEARCH_IDENTIFIER_LIMIT=5
RESULT_SEARCH_IDENTIFIER_WINDOW_SECONDS=300

# REQUIRED in production/any Vercel deployment. Generate a secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# RATE_LIMIT_HASH_SECRET=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Defaults: Upstash in production/Vercel; deterministic memory in local dev/tests.
# Production cannot select memory. Local testing may explicitly select Upstash.
# RESULT_SEARCH_RATE_LIMIT_PROVIDER=upstash
# RESULT_SEARCH_RATE_LIMIT_FAILURE_MODE=closed
# RESULT_SEARCH_RATE_LIMIT_TIMEOUT_MS=2000

# Default: vercel when VERCEL=1, otherwise none (ignore forwarded headers).
# Non-Vercel deployments: use forwarded ONLY behind a trusted, origin-restricted
# proxy that appends X-Forwarded-For and overwrites X-Real-IP. Count proxy hops.
# RESULT_SEARCH_TRUSTED_PROXY=forwarded
# RESULT_SEARCH_TRUSTED_PROXY_HOPS=1

# Security headers: see SECURITY.md. CSP uses the existing Supabase URL above.
# Vercel production builds automatically enable HSTS. For another production host,
# set this ONLY after HTTPS is enforced at the trusted ingress; leave unset locally.
# SECURITY_HTTPS_ONLY=true
# Enable only when ALL subdomains are also permanently served over HTTPS.
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
