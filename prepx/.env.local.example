# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key

# App
NEXT_PUBLIC_APP_NAME=PrepX
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AI import assistant (server-only; never prefix the key with NEXT_PUBLIC_)
# GEMINI_API_KEY=your_actual_gemini_api_key
# GEMINI_IMPORT_MODEL=gemini-3.8-flash

# Public result lookup rate limiting (optional overrides)
# RESULT_RATE_LIMIT_MAX_ATTEMPTS=10
# RESULT_RATE_LIMIT_WINDOW_SECONDS=600
# RESULT_RATE_LIMIT_SECRET=use_a_long_random_server_only_value
