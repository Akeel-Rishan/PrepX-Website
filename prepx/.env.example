# PrepX application environment template.
# Copy to .env.local for development. Never commit real values.

# Public/browser-safe and embedded into the client bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_APP_NAME=PrepX
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase credential. Bypasses RLS; never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Required in Preview and Production for persistent result-search rate limiting.
UPSTASH_REDIS_REST_URL=https://database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token
RATE_LIMIT_HASH_SECRET=replace_with_at_least_32_random_characters

# Optional server-only rate-limit tuning. Defaults shown.
RESULT_SEARCH_RATE_LIMIT=20
RESULT_SEARCH_RATE_WINDOW_SECONDS=300
RESULT_SEARCH_IDENTIFIER_LIMIT=5
RESULT_SEARCH_IDENTIFIER_WINDOW_SECONDS=300
# RESULT_SEARCH_RATE_LIMIT_PROVIDER=upstash
# RESULT_SEARCH_RATE_LIMIT_FAILURE_MODE=closed
# RESULT_SEARCH_RATE_LIMIT_TIMEOUT_MS=2000

# Vercel automatically selects its trusted proxy mode. Leave these unset there.
# Non-Vercel hosts may opt in only behind a trusted, origin-restricted proxy.
# RESULT_SEARCH_TRUSTED_PROXY=forwarded
# RESULT_SEARCH_TRUSTED_PROXY_HOPS=1

# Optional AI import assistant; server-only. Configure one API-key name, not both.
# GEMINI_API_KEY=replace_with_gemini_api_key
# GOOGLE_API_KEY=replace_with_google_api_key
# GEMINI_IMPORT_MODEL=gemini-3.8-flash

# Non-Vercel production hosts only. Vercel enables HTTPS/HSTS automatically.
# SECURITY_HTTPS_ONLY=true
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
